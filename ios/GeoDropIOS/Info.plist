<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>com.e3hi.geodrop.ios</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>GeoDrop</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>GeoDrop needs your location to show nearby drops.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>GeoDrop uses background location only after you enable Nearby alerts, so it can notify you about drops within your chosen radius while the app is closed.</string>
	<key>NSCameraUsageDescription</key>
	<string>GeoDrop uses the camera to attach photos to drops.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>GeoDrop needs photo access to share media in drops.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>GeoDrop needs microphone access to record audio drops.</string>
	<key>FirebaseAppDelegateProxyEnabled</key>
	<true/>
	<key>GOOGLE_MAPS_API_KEY</key>
	<string>$(GOOGLE_MAPS_API_KEY)</string>
	<key>GEODROP_FEATURE_CREATION_ENABLED</key>
	<string>$(GEODROP_FEATURE_CREATION_ENABLED)</string>
	<key>GEODROP_FEATURE_NOTIFICATIONS_ENABLED</key>
	<string>$(GEODROP_FEATURE_NOTIFICATIONS_ENABLED)</string>
	<key>GEODROP_FEATURE_COUPONS_ENABLED</key>
	<string>$(GEODROP_FEATURE_COUPONS_ENABLED)</string>
	<key>GEODROP_FEATURE_MEDIA_ENABLED</key>
	<string>$(GEODROP_FEATURE_MEDIA_ENABLED)</string>
	<key>GEODROP_FEATURE_NSFW_ENABLED</key>
	<string>$(GEODROP_FEATURE_NSFW_ENABLED)</string>
	<key>GEODROP_FEATURE_HUNTS_ENABLED</key>
	<string>$(GEODROP_FEATURE_HUNTS_ENABLED)</string>
</dict>
</plist>
