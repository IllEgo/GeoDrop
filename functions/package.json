{
  "name": "functions",
  "scripts": {
    "lint": "eslint --ext .js,.ts .",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "migrate:launch:check": "node scripts/backfill-launch-fields.js",
    "migrate:launch:apply": "node scripts/backfill-launch-fields.js --apply",
    "migrate:launch:quarantine": "node scripts/backfill-launch-fields.js --apply --quarantine-group-media --quarantine-unsafe-media",
    "migrate:launch:rehearse": "node scripts/rehearse-launch-migration.js",
    "moderator:check": "node scripts/set-moderator-claim.js",
    "moderator:apply": "node scripts/set-moderator-claim.js --apply",
    "moderation:console": "node scripts/moderation-console.js",
    "moderation:rehearse": "node scripts/rehearse-moderation-operations.js",
    "account:audit": "node scripts/account-lifecycle-audit.js",
    "account:rehearse": "node scripts/rehearse-account-lifecycle.js",
    "roles:check": "node scripts/normalize-account-roles.js",
    "roles:apply": "node scripts/normalize-account-roles.js --apply",
    "roles:rehearse": "node scripts/rehearse-account-roles.js",
    "seed:drop:check": "node scripts/seed-test-drop.js",
    "seed:drop:apply": "node scripts/seed-test-drop.js --apply",
    "data:inventory": "node scripts/data-inventory.js",
    "data:inventory:json": "node scripts/data-inventory.js --json",
    "remoteconfig:validate": "node scripts/validate-remote-config-template.js",
    "wipe:check": "node scripts/wipe-prototype-data.js",
    "wipe:apply": "node scripts/wipe-prototype-data.js --apply",
    "wipe:rehearse": "node scripts/rehearse-prototype-wipe.js"
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "@google-cloud/vision": "^3.1.4",
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^4.9.0"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "eslint": "^8.57.0",
    "eslint-config-google": "^0.14.0",
    "eslint-plugin-import": "^2.25.4",
    "firebase-functions-test": "^3.1.0",
    "typescript": "^5.1.6"
  },
  "private": true
}
