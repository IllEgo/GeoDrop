rules_version = '2';
service cloud.firestore {
  function isSignedIn() {
    return request.auth != null
      && (!request.auth.token.keys().hasAny(['suspended'])
        || request.auth.token.suspended != true);
  }

  function isCurrentUser(userId) {
    return isSignedIn() && request.auth.uid == userId;
  }

  function isValidUsername(name) {
    return name is string && name.matches('^[a-z0-9._]{3,20}$');
  }

  // A non-suspended principal that did NOT authenticate anonymously. Drop and
  // media creation require this; anonymous *viewing* remains allowed by the
  // read rules, which do not call this helper.
  function isNonAnonymousUser() {
    return isSignedIn()
      && request.auth.token.firebase.sign_in_provider != 'anonymous';
  }

  match /databases/{database}/documents {
    match /users/{userId} {
      // --- Account model (task 2.7) -------------------------------------
      // Exactly two account types exist: EXPLORER (the default every account
      // starts as) and BUSINESS (organizer). There is no third type and no
      // per-account permission matrix; everything else that varies by
      // principal is either a group-scoped role (users/{uid}/groups) or an
      // operational Auth claim (moderator/admin/suspended), never a field a
      // client can write.
      //
      // Profile fields are split into the ones a client owns and the ones the
      // server owns. Server-owned fields may be PRESENT (the Admin SDK writes
      // them and bypasses these rules) but a client can neither introduce nor
      // change them, so the only path to BUSINESS is the
      // `updateBusinessProfile` callable, which additionally requires a
      // verified email.
      function clientAuthoredUserFields() {
        return [
          'displayName',
          'username',
          'nsfwEnabled',
          'nsfwEnabledAt',
          'createdAt'
        ];
      }

      // Written only by callables (updateBusinessProfile, acceptLegalPolicies,
      // claimExplorerUsername) and moderation tooling. Every Admin-SDK writer
      // of users/{uid} must be represented here: a field written there but
      // missing from this list locks the account out of its own profile,
      // because hasOnlyAllowedUserFields() sees the merged document.
      function serverAuthoredUserFields() {
        return [
          'role',
          'businessName',
          'businessCategories',
          'moderationStatus',
          'suspendedAt',
          'suspendedBy',
          'suspensionReason',
          'suspensionCaseId',
          'reinstatedAt',
          'legalAcceptanceVersion',
          'legalAcceptedAt'
        ];
      }

      function isLaunchAccountRole(role) {
        return role == 'EXPLORER' || role == 'BUSINESS';
      }

      function preservesRole() {
        return isLaunchAccountRole(request.resource.data.get('role', ''))
          && ((resource.data.keys().hasAny(['role'])
              && request.resource.data.role == resource.data.role)
            || (!resource.data.keys().hasAny(['role'])
              && request.resource.data.role == 'EXPLORER'));
      }

      function preservesUsername() {
        return (!resource.data.keys().hasAny(['username'])
            && !request.resource.data.keys().hasAny(['username']))
          || (resource.data.keys().hasAny(['username'])
            && request.resource.data.keys().hasAny(['username'])
            && request.resource.data.username == resource.data.username);
      }

      // `role` is covered by preservesRole(); the rest must survive a client
      // update untouched. affectedKeys() covers added, removed, and changed in
      // one expression, and — unlike comparing values field by field — never
      // compares an absent field against a typed one, which errors instead of
      // returning false. Business metadata is listed so a client cannot unlock
      // the business surface by writing itself a businessName; the moderation
      // fields are listed so a reinstated account can still edit its profile
      // without being able to rewrite its own moderation history.
      function preservesServerAuthoredFields() {
        return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'businessName',
          'businessCategories',
          'moderationStatus',
          'suspendedAt',
          'suspendedBy',
          'suspensionReason',
          'suspensionCaseId',
          'reinstatedAt',
          'legalAcceptanceVersion',
          'legalAcceptedAt'
        ]);
      }

      function hasOnlyAllowedUserFields() {
        return request.resource.data.keys()
          .hasOnly(clientAuthoredUserFields().concat(serverAuthoredUserFields()));
      }

      function hasPilotSafeContentPreference() {
        return !request.resource.data.keys().hasAny(['nsfwEnabled'])
          || request.resource.data.nsfwEnabled == false;
      }

      allow read: if isSignedIn();

      // A new profile is always an explorer, and carries none of the
      // server-owned business or moderation fields.
      allow create: if isCurrentUser(userId)
        && request.resource.data.keys()
          .hasOnly(clientAuthoredUserFields().concat(['role']))
        && hasPilotSafeContentPreference()
        && request.resource.data.role == 'EXPLORER'
        && !request.resource.data.keys().hasAny(['username']);

      allow update: if isCurrentUser(userId)
        && hasOnlyAllowedUserFields()
        && hasPilotSafeContentPreference()
        && preservesRole()
        && preservesUsername()
        && preservesServerAuthoredFields()
        && (!request.resource.data.keys().hasAny(['username'])
            || isValidUsername(request.resource.data.username));
    }

    match /usernames/{username} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(['userId'])
        && request.resource.data.userId == request.auth.uid;

      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasOnly(['userId'])
        && request.resource.data.userId == resource.data.userId;

      allow delete: if isSignedIn()
        && resource.data.userId == request.auth.uid;
    }

    match /reports/{reportId} {
      function hasValidReportShape() {
        return request.resource.data.keys().hasOnly([
          'dropId',
          'reportedBy',
          'reportedAt',
          'reasonCodes',
          'status',
          'context'
        ])
          && request.resource.data.dropId is string
          && request.resource.data.dropId.size() > 0
          && request.resource.data.dropId.size() <= 128
          && request.resource.data.reportedBy == request.auth.uid
          && (request.resource.data.reportedAt is int
            || request.resource.data.reportedAt is timestamp)
          && request.resource.data.reasonCodes is list
          && request.resource.data.reasonCodes.size() > 0
          && request.resource.data.reasonCodes.size() <= 5
          && request.resource.data.reasonCodes.hasOnly([
            'spam', 'harassment', 'nsfw', 'violence', 'other', 'unspecified'
          ])
          && request.resource.data.status == 'pending'
          && (!request.resource.data.keys().hasAny(['context'])
            || (request.resource.data.context is map
              && request.resource.data.context.keys().hasOnly([
                'source', 'contentType', 'hasMedia', 'dropType'
              ])))
          && exists(/databases/$(database)/documents/drops/$(request.resource.data.dropId));
      }

      allow create: if isSignedIn() && hasValidReportShape();
      allow read, update, delete: if false;
    }

    match /groups/{groupCode} {
      function isGroupOwner() {
        return isSignedIn()
          && resource.data.keys().hasAny(['ownerId'])
          && resource.data.ownerId == request.auth.uid;
      }

      function hasGroupMembership() {
        return isSignedIn()
          && exists(/databases/$(database)/documents/users/$(request.auth.uid)/groups/$(groupCode));
      }

      // A group code is an invitation capability. Document reads are limited
      // to people who already possess membership, and collection enumeration
      // is always denied. The manageGroup callable uses the Admin SDK for all
      // group and membership mutations.
      //
      // These denies are also the enforcement for deferred public group
      // creation (task 1.3): a client can neither create a group nor discover
      // one it was not invited to. Do not loosen without reversing the
      // direction doc's deferred list.
      allow get: if isGroupOwner() || hasGroupMembership();
      allow list, create, update, delete: if false;
    }

    match /drops/{dropId} {
      function isDropOwner(data, userId) {
        return data.createdBy is string && data.createdBy == userId;
      }

      function isActiveDrop(data) {
        return !(data.keys().hasAny(['isDeleted']) && data.isDeleted == true);
      }

      function hasTruthyValue(value) {
        return (value is bool && value == true)
          || (value is int && value != 0)
          || (value is float && value != 0)
          || (value is timestamp)
          || (
            value is string
            && value.size() > 0
            && !(value.lower() in ['false', '0', 'off', 'no'])
          )
          || (value is map && value.size() > 0)
          || (value is list && value.size() > 0);
      }

      function hasCollectedDrop(data, userId) {
        return (data.collectedBy is map)
          && data.collectedBy.keys().hasAny([userId])
          && data.collectedBy[userId] != null
          && hasTruthyValue(data.collectedBy[userId]);
      }

      function isNsfwDrop(data) {
        return data.keys().hasAny(['isNsfw']) && data.isNsfw == true;
      }

      function isPublicDrop(data) {
        return data.keys().hasAny(['visibility'])
          && data.visibility == 'PUBLIC';
      }

      function isGroupDrop(data) {
        return data.keys().hasAny(['visibility', 'groupCode'])
          && data.visibility == 'GROUP'
          && data.groupCode is string
          && data.groupCode.size() > 0;
      }

      function isGroupMember(data, userId) {
        return isGroupDrop(data)
          && exists(/databases/$(database)/documents/users/$(userId)/groups/$(data.groupCode));
      }

      function canAccessVisibility(data, userId) {
        return isPublicDrop(data)
          || isDropOwner(data, userId)
          || isGroupMember(data, userId);
      }

      function canBrowseDrop(data, userId) {
        return canAccessVisibility(data, userId)
          && !isNsfwDrop(data)
          && (isDropOwner(data, userId)
            || isActiveDrop(data)
            || hasCollectedDrop(data, userId));
      }

      allow get: if (isSignedIn()
          && canBrowseDrop(resource.data, request.auth.uid))
        || (!isSignedIn()
          && isPublicDrop(resource.data)
          && isActiveDrop(resource.data)
          && !isNsfwDrop(resource.data));

      // Query authorization uses canonical, required booleans so Firestore can
      // prove the result set is safe. Client-side filtering is never trusted.
      allow list: if resource.data.isDeleted == false
        && resource.data.isNsfw == false
        && (
          resource.data.visibility == 'PUBLIC'
          || (isSignedIn() && isDropOwner(resource.data, request.auth.uid))
          || (isSignedIn()
            && resource.data.visibility == 'GROUP'
            && resource.data.groupCode is string
            && exists(/databases/$(database)/documents/users/$(request.auth.uid)/groups/$(resource.data.groupCode)))
        );
      function hasOnlyAllowedDropFields() {
        return request.resource.data.keys().hasOnly([
          'text',
          'description',
          'lat',
          'lng',
          'createdBy',
          'createdAt',
          'isDeleted',
          'deletedAt',
          'visibility',
          'groupCode',
          'isAnonymous',
          'dropType',
          'businessId',
          'businessName',
          'contentType',
          'mediaUrl',
          'mediaMimeType',
          'mediaData',
          'mediaStoragePath',
          'isNsfw',
          'nsfw',
          'nsfwLabels',
          'dropperUsername',
          'likeCount',
          'likedBy',
          'reportCount',
          'reportedBy',
          'redemptionCode',
          'redemptionLimit',
          'redemptionCount',
          'redeemedBy',
          'decayDays',
          'collectedBy',
          'huntId',
          'huntStepIndex',
          'huntTotalSteps'
        ]);
      }

      function isExplorer() {
        return isSignedIn()
          && exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'EXPLORER';
      }

      function isBusiness() {
        return isSignedIn()
          && exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'BUSINESS';
      }

      function isBusinessDrop(data) {
        return data.dropType is string && data.dropType != 'COMMUNITY';
      }

      function hasValidVisibility(data) {
        return (data.visibility == 'PUBLIC'
            && (!data.keys().hasAny(['groupCode']) || data.groupCode == null))
          || (data.visibility == 'GROUP'
            && data.groupCode is string
            && data.groupCode.size() > 0
            && isSignedIn()
            && exists(/databases/$(database)/documents/users/$(request.auth.uid)/groups/$(data.groupCode)));
      }

      // --- Deferred-feature denials (tasks 1.3, 2.6) ----------------------
      // Video content and client-authored NSFW flags are rejected at create.
      // Dislike fields are no longer allowed keys at all (see
      // hasOnlyAllowedDropFields above and the update helpers below), so 1.3's
      // hasNoSeededVotes check became redundant and was removed at 2.6. These
      // close WRITES only; existing documents stay readable under the rules
      // above.

      function isVideoContent(data) {
        return (data.keys().hasAny(['contentType']) && data.contentType == 'VIDEO')
          || (data.keys().hasAny(['mediaMimeType'])
            && data.mediaMimeType is string
            && data.mediaMimeType.matches('video/.*'));
      }

      // Only the backend moderation pipeline (Admin SDK, which bypasses rules)
      // may flag content. A client can never author an NSFW state.
      function hasNoClientNsfwFlags(data) {
        return data.isNsfw == false
          && (!data.keys().hasAny(['nsfw']) || data.nsfw == false)
          && (!data.keys().hasAny(['nsfwLabels'])
            || data.nsfwLabels == null
            || (data.nsfwLabels is list && data.nsfwLabels.size() == 0));
      }

      function groupDropHasNoMedia(data) {
        return data.visibility != 'GROUP'
          || (data.contentType == 'TEXT'
            && (!data.keys().hasAny(['mediaUrl']) || data.mediaUrl == null)
            && (!data.keys().hasAny(['mediaMimeType']) || data.mediaMimeType == null)
            && (!data.keys().hasAny(['mediaData']) || data.mediaData == null)
            && (!data.keys().hasAny(['mediaStoragePath']) || data.mediaStoragePath == null));
      }

      allow create: if hasOnlyAllowedDropFields()
        && isNonAnonymousUser()
        && (!request.resource.data.keys().hasAny(['isAnonymous'])
          || request.resource.data.isAnonymous == false)
        && request.resource.data.isDeleted == false
        && hasNoClientNsfwFlags(request.resource.data)
        && !isVideoContent(request.resource.data)
        && hasValidVisibility(request.resource.data)
        && groupDropHasNoMedia(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid
        && (
          (isExplorer() && !isBusinessDrop(request.resource.data))
          || (isBusiness()
            && (
              !isBusinessDrop(request.resource.data)
              || request.resource.data.businessId == request.auth.uid
            ))
        );

      function hasOnlyUserCollectedChange(before, after, userId) {
        let beforeCollectedBy = (before.collectedBy is map) ? before.collectedBy : {};
        let afterCollectedBy = (after.collectedBy is map) ? after.collectedBy : {};
        return beforeCollectedBy.diff(afterCollectedBy).affectedKeys().hasOnly([userId]);
      }

      function isValidReactionTransition(before, after, userId, mapField, countField) {
        let beforeMap = (before[mapField] is map) ? before[mapField] : {};
        let afterMap = (after[mapField] is map) ? after[mapField] : {};
        let beforeCount = (before[countField] is int) ? before[countField] : 0;
        let afterCount = (after[countField] is int) ? after[countField] : 0;
        let beforeHas = beforeMap.keys().hasAny([userId]);
        let afterHas = afterMap.keys().hasAny([userId]);
        return beforeCount >= 0
          && afterCount >= 0
          && beforeMap.diff(afterMap).affectedKeys().hasOnly([userId])
          && (!afterHas || afterMap[userId] == true)
          && (
            (beforeHas == afterHas && afterCount == beforeCount)
            || (!beforeHas && afterHas && afterCount == beforeCount + 1)
            || (beforeHas && !afterHas && afterCount == beforeCount - 1)
          );
      }

      function isValidReportTransition(before, after, userId) {
        let beforeMap = (before.reportedBy is map) ? before.reportedBy : {};
        let afterMap = (after.reportedBy is map) ? after.reportedBy : {};
        let beforeCount = (before.reportCount is int) ? before.reportCount : 0;
        let afterCount = (after.reportCount is int) ? after.reportCount : 0;
        let beforeHas = beforeMap.keys().hasAny([userId]);
        let afterHas = afterMap.keys().hasAny([userId]);
        return beforeCount >= 0
          && afterCount >= 0
          && beforeMap.diff(afterMap).affectedKeys().hasOnly([userId])
          && (!afterHas
            || afterMap[userId] is int
            || afterMap[userId] is timestamp)
          && (
            (beforeHas && afterHas && afterCount == beforeCount)
            || (!beforeHas && afterHas && afterCount == beforeCount + 1)
            || (!beforeHas && !afterHas && afterCount == beforeCount)
          );
      }

      // Dislikes were removed outright at task 2.6. They are no longer allowed
      // keys in either update helper below, so a write touching dislikedBy or
      // dislikeCount — casting, retracting, or merely restating a zero — is
      // rejected. Simple likes are launch scope and keep their full transition
      // rules.
      function hasValidSocialTransitions(before, after, userId) {
        let affected = before.diff(after).affectedKeys();
        return (!affected.hasAny(['likedBy', 'likeCount'])
            || isValidReactionTransition(before, after, userId, 'likedBy', 'likeCount'))
          && (!affected.hasAny(['reportedBy', 'reportCount'])
            || isValidReportTransition(before, after, userId));
      }

      function isValidLikeReportCollectUpdate(before, after, userId) {
        let allowedWriteFields = [
            'likedBy',
            'likeCount',
            'collectedBy',
            'reportedBy',
            'reportCount'
          ]
          .concat(['likedBy.' + userId])
          .concat(['collectedBy.' + userId])
          .concat(['reportedBy.' + userId]);
        let hasOnlyAllowedFields = before.diff(after).affectedKeys().hasOnly(allowedWriteFields);
        let collectedChanged = before.collectedBy != after.collectedBy;

        return collectedChanged
          && hasOnlyAllowedFields
          && hasValidSocialTransitions(before, after, userId)
          && hasOnlyUserCollectedChange(before, after, userId);
      }

      function isRedeemableDrop(data) {
        return data.get('dropType', '') == 'RESTAURANT_COUPON';
      }

      // Every read here goes through map.get(). A bare `data.field` — even inside
      // `data.field is int` — raises an evaluation error when the field is absent
      // rather than evaluating false, which silently fails the whole statement.
      // That is what made redemption unreachable: redemptionLimit was optional.
      function isValidRedemptionTransition(before, after, userId) {
        let beforeRedeemedBy = before.get('redeemedBy', {});
        let afterRedeemedBy = after.get('redeemedBy', {});
        let beforeCount = before.get('redemptionCount', 0);
        let afterCount = after.get('redemptionCount', -1);
        let limit = before.get('redemptionLimit', -1);

        return beforeCount is int
          && afterCount is int
          && !beforeRedeemedBy.keys().hasAny([userId])
          && afterRedeemedBy.keys().hasAny([userId])
          && beforeRedeemedBy.diff(afterRedeemedBy).affectedKeys().hasOnly([userId])
          && afterRedeemedBy[userId] is int
          && afterCount == beforeCount + 1
          && (limit < 0 || afterCount <= limit);
      }

      function hasUserCollectedBeforeOrAfter(before, after, userId) {
        return hasCollectedDrop(before, userId)
          || hasCollectedDrop(after, userId);
      }

      // Allows like/report updates without requiring collection check.
      // Used for business drops where markDropCollected may not have completed yet.
      function isLikeReportOnlyUpdate(before, after, userId) {
        let allowedFields = [
            'likedBy',
            'likeCount',
            'reportedBy',
            'reportCount'
          ]
          .concat(['likedBy.' + userId])
          .concat(['reportedBy.' + userId]);
        return before.diff(after).affectedKeys().hasOnly(allowedFields)
          && hasValidSocialTransitions(before, after, userId);
      }

      // Task 4.1 — drop expiration is enforced here, not only drawn in the client.
      // A drop with a positive decayDays stops being collectable (and redeemable)
      // once createdAt + decayDays has passed. Drops without a decay never expire.
      function isNotExpired(data) {
        let days = data.get('decayDays', 0);
        let created = data.get('createdAt', 0);
        return days <= 0
          || created <= 0
          || request.time.toMillis() < created + days * 86400000;
      }

      // One allow-statement per write shape, ordered cheapest-guard-first (tasks
      // 4.1, 4.3). These are OR'd, but Firestore's 1000-expression budget is spent
      // across the whole request, not per statement — so a write that only matches
      // the last statement pays for every earlier one first. Redemption was last and
      // ran out of budget, meaning a real redemption could be refused. Each statement
      // now opens with a single-field guard so a non-matching write exits immediately.
      // Keep it that way: put new conditions behind the cheapest discriminator.

      // Redeeming a business offer. `isRedeemableDrop` is one field compare, so every
      // other write shape falls through this in constant time.
      allow update: if isSignedIn()
        && isRedeemableDrop(resource.data)
        && isNotExpired(resource.data)
        && resource.data.diff(request.resource.data).affectedKeys().hasOnly([
          'redeemedBy.' + request.auth.uid,
          'redemptionCount'
        ])
        && isValidRedemptionTransition(resource.data, request.resource.data, request.auth.uid);

      // The creator soft-deleting their own drop, expired or not. Also one compare.
      allow update: if isSignedIn()
        && resource.data.createdBy == request.auth.uid
        && resource.data.diff(request.resource.data).affectedKeys().hasOnly(['isDeleted', 'deletedAt'])
        && request.resource.data.isDeleted == true
        && request.resource.data.deletedAt is int;

      // Any signed-in user may like or report, including on an expired drop:
      // moderation cannot depend on a drop still being live.
      allow update: if isSignedIn()
        && isLikeReportOnlyUpdate(resource.data, request.resource.data, request.auth.uid);

      // Collecting. Expiry is enforced here, and a claim is one-way (task 4.2):
      // once your entry exists it cannot be removed or falsified, so a claim
      // cannot be farmed by collecting, un-collecting and collecting again.
      allow update: if isSignedIn()
        && isValidLikeReportCollectUpdate(resource.data, request.resource.data, request.auth.uid)
        && isNotExpired(resource.data)
        && (
          !hasCollectedDrop(resource.data, request.auth.uid)
          || hasCollectedDrop(request.resource.data, request.auth.uid)
        )
        && (
          isDropOwner(resource.data, request.auth.uid)
          || hasUserCollectedBeforeOrAfter(resource.data, request.resource.data, request.auth.uid)
        );

      allow delete: if isSignedIn()
        && resource.data.createdBy == request.auth.uid;
    }

    match /users/{userId}/groups/{groupCode} {
      allow read: if isCurrentUser(userId);
      allow create, update, delete: if false;
    }

    match /users/{userId}/blockedCreators/{blockedId} {
      function hasOnlyAllowedBlockedCreatorFields() {
        return request.resource.data.keys().hasOnly([
          'creatorId',
          'blockedAt'
        ]);
      }

      function isValidBlockedCreatorFields() {
        return (!request.resource.data.keys().hasAny(['creatorId'])
            || request.resource.data.creatorId is string)
          && (!request.resource.data.keys().hasAny(['blockedAt'])
            || request.resource.data.blockedAt is number);
      }

      allow read: if isCurrentUser(userId);

      allow create, update: if isCurrentUser(userId)
        && hasOnlyAllowedBlockedCreatorFields()
        && isValidBlockedCreatorFields();

      allow delete: if isCurrentUser(userId);
    }

    match /users/{userId}/inventory/{dropId} {
      function hasOnlyAllowedInventoryFields() {
        return request.resource.data.keys().hasOnly([
          'id',
          'text',
          'description',
          'contentType',
          'collectedAt',
          'dropType',
          'redemptionCount',
          'isRedeemed',
          'redeemedAt',
          'likeCount',
          'isLiked',
          'state',
          'updatedAt',
          'mediaUrl',
          'mediaMimeType',
          'mediaData',
          'lat',
          'lng',
          'groupCode',
          'dropCreatedAt',
          'dropperUsername',
          'createdByUsername',
          'decayDays',
          'businessId',
          'businessName',
          'redemptionLimit',
          'isNsfw',
          'nsfwLabels',
          'huntId',
          'huntStepIndex',
          'huntTotalSteps'
        ]);
      }

      function isValidInventoryState() {
        return !request.resource.data.keys().hasAny(['state'])
          || request.resource.data.state in ['COLLECTED', 'IGNORED'];
      }

      function isValidInventoryTypes() {
        return (!request.resource.data.keys().hasAny(['collectedAt'])
            || request.resource.data.collectedAt is int)
          && (!request.resource.data.keys().hasAny(['redeemedAt'])
            || request.resource.data.redeemedAt is int)
          && (!request.resource.data.keys().hasAny(['likeCount'])
            || request.resource.data.likeCount is int)
          && (!request.resource.data.keys().hasAny(['isLiked'])
            || request.resource.data.isLiked is bool)
          && (!request.resource.data.keys().hasAny(['updatedAt'])
            || request.resource.data.updatedAt is int)
          && (!request.resource.data.keys().hasAny(['lat'])
            || request.resource.data.lat is number)
          && (!request.resource.data.keys().hasAny(['lng'])
            || request.resource.data.lng is number)
          && (!request.resource.data.keys().hasAny(['nsfwLabels'])
            || request.resource.data.nsfwLabels is list);
      }

      allow read: if isCurrentUser(userId);

      allow create, update: if isCurrentUser(userId)
        && hasOnlyAllowedInventoryFields()
        && isValidInventoryState()
        && isValidInventoryTypes();

      allow delete: if isCurrentUser(userId);
    }

    match /huntChains/{huntId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.keys().hasOnly([
            'createdBy', 'createdAt', 'businessId', 'businessName',
            'title', 'description', 'dropIds', 'isActive',
            'decayDays', 'totalSteps'
        ]);

      allow update: if isSignedIn()
        && resource.data.createdBy == request.auth.uid
        && request.resource.data.keys().hasOnly([
            'createdBy', 'createdAt', 'businessId', 'businessName',
            'title', 'description', 'dropIds', 'isActive',
            'decayDays', 'totalSteps'
        ]);

      allow delete: if false;
    }

    match /users/{userId}/huntProgress/{huntId} {
      allow read: if isCurrentUser(userId);

      allow create, update: if isCurrentUser(userId)
        && request.resource.data.keys().hasOnly([
            'huntId', 'currentStepIndex', 'completedStepIds',
            'completedAt', 'startedAt'
        ])
        && request.resource.data.currentStepIndex is int
        && request.resource.data.completedStepIds is list;

      allow delete: if isCurrentUser(userId);
    }

    match /users/{userId}/notificationTokens/{tokenId} {
      function hasOnlyAllowedTokenFields() {
        return request.resource.data.keys().hasOnly([
          'token',
          'platform',
          'updatedAt'
        ]);
      }

      allow read: if isCurrentUser(userId);

      allow create, update: if isCurrentUser(userId)
        && hasOnlyAllowedTokenFields()
        && request.resource.data.token is string
        && (!request.resource.data.keys().hasAny(['platform'])
          || request.resource.data.platform is string)
        && (!request.resource.data.keys().hasAny(['updatedAt'])
          || request.resource.data.updatedAt is int);

      allow delete: if isCurrentUser(userId);
    }

    match /users/{userId}/reportStatuses/{reportId} {
      allow read: if isCurrentUser(userId);
      allow create, update, delete: if false;
    }

    // Open direct messaging is deferred (task 1.3). No DM collection exists
    // today, so these are defense-in-depth on top of the default deny: if one
    // is ever created by accident, it is unwritable and unreadable from a
    // client rather than silently inheriting a permissive rule.
    match /messages/{document=**} {
      allow read, write: if false;
    }

    match /threads/{document=**} {
      allow read, write: if false;
    }

    match /conversations/{document=**} {
      allow read, write: if false;
    }

    match /directMessages/{document=**} {
      allow read, write: if false;
    }

    match /dms/{document=**} {
      allow read, write: if false;
    }

    match /users/{userId}/messages/{document=**} {
      allow read, write: if false;
    }

    match /users/{userId}/threads/{document=**} {
      allow read, write: if false;
    }

    match /users/{userId}/conversations/{document=**} {
      allow read, write: if false;
    }
  }
}
