    <string name="faq_title">Conoce Kithe</string>
    <string name="faq_intro">Kithe se basa en compartir drops vinculados a lugares. Aquí tienes un resumen de cómo funciona todo.</string>
    <string name="faq_question_core_features">¿Cuáles son las funciones principales de Kithe?</string>
    <string name="faq_answer_core_features">Crea drops en lugares reales, explora lo que hay cerca y conecta con personas y lugares mediante historias, ofertas y novedades interactivas.</string>
    <string name="faq_question_drop_contents">¿Qué puede incluir un drop?</string>
    <string name="faq_answer_drop_contents">Los drops pueden incluir notas de texto, fotos, clips de voz e incluso recompensas o cupones de negocios. Combina lo que mejor se adapte al momento.</string>
    <string name="faq_question_explorer_usage">¿Cómo usan los exploradores los drops?</string>
    <string name="faq_answer_explorer_usage">Los exploradores siguen el mapa o las notificaciones para visitar drops, abrir el contenido, reaccionar o recogerlo y guardar sus favoritos para futuras aventuras.</string>
    <string name="faq_question_groups">¿Cómo funcionan los grupos de Kithe?</string>
    <string name="faq_answer_groups">Los grupos reúnen a exploradores con intereses, vecindarios o negocios en común. Únete a un grupo para ver drops exclusivos y mantenerte al día con la comunidad.</string>
    <string name="faq_close">Cerrar</string>
</resources>
